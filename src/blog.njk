---
layout: base.njk
title: Eye Care Blog — Tips, Guides & Eyewear News
description: Expert articles on sunglasses, eyeglasses, contact lenses, and eye health from the team at PIIXELL by Naina Optics, Bangalore.
bodyClass: page-blog
pageScript: blog.js
---

<!-- Pass all articles to blog.js as JSON -->
<script id="articlesData" type="application/json">
  {{ articles | jsonify | safe }}
</script>

<div class="page-header">
  <div class="container">
    <h1>Eye Care Blog</h1>
    <p>Expert guides, buying tips, and optical industry insights from our team</p>
  </div>
</div>

<section class="section">
  <div class="container">

    <!-- FEATURED ARTICLE -->
    {% set featured = articles | where("featured", true) | limit(1) %}
    {% for article in featured %}
    <div class="featured-article">
      <div class="featured-article__inner">
        <span class="featured-article__label">Featured Article</span>
        <h2>{{ article.title }}</h2>
        <p>{{ article.excerpt }}</p>
        <div class="featured-article__meta">
          <span>✍️ {{ article.author }}</span>
          <span>📅 {{ article.date | readableDate }}</span>
          <span>⏱ {{ article.readTime }} min read</span>
        </div>
        <button class="btn btn--accent open-article-btn"
                data-id="{{ article.id }}">
          Read Full Article →
        </button>
      </div>
    </div>
    {% endfor %}

    <!-- CONTROLS: SEARCH + CATEGORY FILTER -->
    <div class="blog-controls">
      <div class="search-box">
        <svg class="search-box__icon" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
        <input type="search" id="blogSearch" placeholder="Search articles…" aria-label="Search blog articles">
      </div>
      <div class="filter-bar" style="margin-bottom:0;">
        <button class="filter-btn active" data-blog-filter="all">All</button>
        <button class="filter-btn" data-blog-filter="sunglasses">Sunglasses</button>
        <button class="filter-btn" data-blog-filter="eyeglasses">Eyeglasses</button>
        <button class="filter-btn" data-blog-filter="contact-lenses">Contact Lenses</button>
        <button class="filter-btn" data-blog-filter="eye-care">Eye Care</button>
        <button class="filter-btn" data-blog-filter="news">News</button>
      </div>
    </div>

    <!-- ARTICLE GRID (populated by blog.js) -->
    <div class="blog-grid" id="blogGrid">
      {% for article in articles %}
      <article class="article-card"
               data-category="{{ article.category }}"
               data-id="{{ article.id }}"
               data-title="{{ article.title | lower }}"
               data-excerpt="{{ article.excerpt | lower }}">
        <div class="article-card__image">
          <!-- TODO: <img src="/assets/images/blog/{{ article.image }}" alt="{{ article.title }}" loading="lazy"> -->
          {% if article.category == "sunglasses" %}🕶️
          {% elif article.category == "eyeglasses" %}👓
          {% elif article.category == "contact-lenses" %}👁️
          {% elif article.category == "eye-care" %}🔬
          {% else %}📰{% endif %}
        </div>
        <div class="article-card__body">
          <div class="article-card__meta">
            <span class="badge badge--{{ article.category }}">{{ article.categoryLabel }}</span>
            <span>{{ article.readTime }} min</span>
          </div>
          <h3 class="article-card__title">{{ article.title }}</h3>
          <p class="article-card__excerpt">{{ article.excerpt }}</p>
          <div class="article-card__footer">
            <span>{{ article.date | readableDate }}</span>
            <button class="article-card__readmore open-article-btn" data-id="{{ article.id }}">
              Read More →
            </button>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>

    <!-- NO RESULTS -->
    <p id="blogNoResults" style="display:none; text-align:center; color:var(--text-muted); padding:3rem 0; font-size:1.1rem;">
      No articles match your search. <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">Ask us on WhatsApp →</a>
    </p>

    <!-- PAGINATION -->
    <div class="pagination" id="blogPagination" role="navigation" aria-label="Blog pagination"></div>

    <!-- NEWSLETTER -->
    <div style="background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg); padding:2.5rem; text-align:center; margin-top:3rem;">
      <h3 style="margin-bottom:0.5rem;">📬 Stay Updated</h3>
      <p style="color:var(--text-muted); margin-bottom:1.5rem;">Get new articles and exclusive offers from Naina Optics delivered to your inbox.</p>
      <form id="blogNewsletterForm" novalidate style="display:flex; gap:0.75rem; max-width:420px; margin:0 auto; flex-wrap:wrap;">
        <input type="email" name="email" placeholder="your@email.com" required
               style="flex:1; min-width:0; padding:0.7rem 1rem; border:2px solid var(--border); border-radius:var(--radius-full); background:var(--bg); color:var(--text); font-size:0.9rem; font-family:inherit; outline:none; transition:border-color var(--transition);"
               aria-label="Email for newsletter">
        <button type="submit" class="btn btn--accent">Subscribe</button>
      </form>
    </div>

  </div>
</section>

<!-- ARTICLE MODAL (populated by blog.js) -->
<div class="modal-overlay" id="articleModal" role="dialog" aria-modal="true" aria-labelledby="articleModalTitle">
  <div class="modal">
    <button class="modal__close" id="closeArticleModal" aria-label="Close article">✕</button>
    <div class="modal__category" id="articleModalCategory"></div>
    <h2 id="articleModalTitle"></h2>
    <div class="modal__meta" id="articleModalMeta"></div>
    <div class="modal__content" id="articleModalContent"></div>
  </div>
</div>
