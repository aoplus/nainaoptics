---
layout: base.njk
title: Products — Sunglasses, Eyeglasses & Contact Lenses
description: Shop Ray-Ban, Oakley, Crizal, Polaroid and more at PIIXELL by Naina Optics, Residency Road Bangalore. Sunglasses, eyeglasses, and contact lenses — all genuine with warranty.
bodyClass: page-products
---

<div class="page-header">
  <div class="container">
    <h1>Our Products</h1>
    <p>Premium eyewear across three categories — all genuine, all warranted, all fitted by experts</p>
  </div>
</div>

<section class="section">
  <div class="container">

    <!-- FILTER BAR -->
    <div class="filter-bar" role="group" aria-label="Filter products by category">
      <button class="filter-btn active" data-filter="all">All Products</button>
      <button class="filter-btn" data-filter="sunglasses">🕶️ Sunglasses</button>
      <button class="filter-btn" data-filter="eyeglasses">👓 Eyeglasses</button>
      <button class="filter-btn" data-filter="contact-lenses">👁️ Contact Lenses</button>
    </div>

    <!-- PRODUCT GRID -->
    <div class="products-grid" id="productsGrid">
      {% for product in products %}
      <div class="product-card" data-category="{{ product.category }}">
        <div class="product-card__image product-card__image--placeholder">
          <!-- TODO: Add image when available:
               <img src="/assets/images/products/{{ product.image }}" alt="{{ product.alt }}" loading="lazy">
               Remove the placeholder emoji below once image is added. -->
          <span class="product-card__badge badge badge--product">{{ product.badge }}</span>
          {% if product.category == "sunglasses" %}🕶️
          {% elif product.category == "eyeglasses" %}👓
          {% else %}👁️{% endif %}
        </div>
        <div class="product-card__body">
          <div class="product-card__category">
            <span class="badge badge--{{ product.category }}">{{ product.brand }}</span>
          </div>
          <h2 class="product-card__name">{{ product.name }}</h2>
          <p class="product-card__desc">{{ product.description }}</p>
          <div class="product-card__footer">
            <span class="product-card__price">{{ product.price }}</span>
            <button class="btn btn--accent btn--sm enquire-btn"
                    data-product="{{ product.name }}"
                    data-price="{{ product.price }}">
              Enquire
            </button>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>

    <!-- NOTE: No products match message -->
    <p class="no-products-msg" id="noProductsMsg" style="display:none; text-align:center; color:var(--text-muted); padding:3rem 0; font-size:1.1rem;">
      No products in this category yet. <a href="https://wa.me/{{ site.whatsapp }}">Ask us on WhatsApp →</a>
    </p>

  </div>
</section>

<!-- WHY BUY FROM US -->
<section class="section" style="background:var(--surface);">
  <div class="container">
    <div class="section-header">
      <h2>Why Buy From Naina Optics?</h2>
    </div>
    <div class="features-grid">
      <div class="feature-card">
        <span class="feature-icon">🛡️</span>
        <h3>100% Genuine Products</h3>
        <p>All frames are sourced from authorised distributors. Every product comes with manufacturer warranty and authenticity certificate.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🔧</span>
        <h3>Expert Fitting</h3>
        <p>Frame fitting, lens centration, and adjustment — our team ensures your glasses are perfectly aligned for comfort and optical accuracy.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">📞</span>
        <h3>WhatsApp Enquiries</h3>
        <p>Not sure what to choose? Message us on WhatsApp with your requirements and we'll guide you to the right product.</p>
      </div>
    </div>
  </div>
</section>

<!-- Enquiry Modal -->
<div class="modal-overlay enquiry-modal" id="enquiryModal" role="dialog" aria-modal="true" aria-labelledby="enquiryTitle">
  <div class="modal">
    <button class="modal__close" id="closeEnquiry" aria-label="Close">✕</button>
    <h2 id="enquiryTitle">Enquire About This Product</h2>
    <p style="color:var(--text-muted); margin-bottom:1.5rem; font-size:0.9rem;">Fill in your details and we'll open a WhatsApp message to our team.</p>
    <form id="enquiryForm" novalidate>
      <div class="form-group">
        <label for="enqProduct">Product</label>
        <input type="text" id="enqProduct" name="product" readonly style="background:var(--border);">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="enqName">Your Name *</label>
          <input type="text" id="enqName" name="name" required placeholder="Rahul Sharma">
          <span class="form-error">Please enter your name.</span>
        </div>
        <div class="form-group">
          <label for="enqPhone">Phone *</label>
          <input type="tel" id="enqPhone" name="phone" required placeholder="9876543210">
          <span class="form-error">Please enter your phone number.</span>
        </div>
      </div>
      <div class="form-group">
        <label for="enqMessage">Message (optional)</label>
        <textarea id="enqMessage" name="message" rows="3" placeholder="Any specific questions?"></textarea>
      </div>
      <button type="submit" class="btn btn--whatsapp" style="width:100%;">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Send via WhatsApp
      </button>
    </form>
  </div>
</div>
