---
layout: base.njk
title: Contact Us — Visit Naina Optics, Residency Road Bangalore
description: Find PIIXELL by Naina Optics at No. 001, Centre Point, Residency Road, Bangalore 560025. Call +91 77605 42829, WhatsApp, or fill in our contact form.
bodyClass: page-contact
---

<div class="page-header">
  <div class="container">
    <h1>Contact Us</h1>
    <p>We're on Residency Road, open every day — come visit or reach us on WhatsApp</p>
  </div>
</div>

<section class="section">
  <div class="container">

    <!-- CONTACT INFO CARDS -->
    <div class="contact-cards">
      <div class="contact-card">
        <div class="contact-card__icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
        </div>
        <div class="contact-card__label">Phone</div>
        <div class="contact-card__value"><a href="tel:{{ site.phoneRaw }}">{{ site.phone }}</a></div>
      </div>
      <div class="contact-card">
        <div class="contact-card__icon" style="background:rgba(37,211,102,0.1); color:#25D366;">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        </div>
        <div class="contact-card__label">WhatsApp</div>
        <div class="contact-card__value">
          <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">{{ site.phone }}</a>
        </div>
      </div>
      <div class="contact-card">
        <div class="contact-card__icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
        </div>
        <div class="contact-card__label">Email</div>
        <div class="contact-card__value"><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
      </div>
      <div class="contact-card">
        <div class="contact-card__icon">
          <svg viewBox="0 0 24 24" fill="currentColor" width="22" height="22"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        </div>
        <div class="contact-card__label">Location</div>
        <div class="contact-card__value" style="font-size:0.85rem;">{{ site.fullAddress }}</div>
      </div>
    </div>

    <!-- GOOGLE MAP -->
    <div class="map-container">
      {% if site.mapEmbedUrl %}
      <iframe
        src="{{ site.mapEmbedUrl }}"
        allowfullscreen=""
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        title="Naina Optics location on Google Maps">
      </iframe>
      {% else %}
      <!-- TODO: Replace this placeholder with your Google Maps embed code.
           Go to maps.google.com → search your address → Share → Embed a map → Copy HTML
           Paste the <iframe src="..."> URL into site.json as "mapEmbedUrl" -->
      <div class="map-placeholder">
        <svg viewBox="0 0 24 24" fill="currentColor" width="48" height="48" style="opacity:0.5;"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/></svg>
        <strong>No. 001, Centre Point, Residency Road</strong>
        <p>Bangalore – 560025, Karnataka</p>
        <a href="https://maps.google.com/?q=Centre+Point+Residency+Road+Bangalore+560025"
           class="btn btn--outline-white btn--sm"
           target="_blank"
           rel="noopener noreferrer">
          Open in Google Maps ↗
        </a>
      </div>
      {% endif %}
    </div>

    <div class="contact-grid">

      <!-- CONTACT FORM -->
      <div>
        <h2 style="margin-bottom:1.5rem;">Send Us a Message</h2>
        <div class="contact-form">
          <form id="contactForm" novalidate>
            <div class="form-row">
              <div class="form-group">
                <label for="ctName">Your Name *</label>
                <input type="text" id="ctName" name="name" required placeholder="Rahul Sharma">
                <span class="form-error">Please enter your name.</span>
              </div>
              <div class="form-group">
                <label for="ctPhone">Phone Number *</label>
                <input type="tel" id="ctPhone" name="phone" required placeholder="9876543210">
                <span class="form-error">Please enter your phone number.</span>
              </div>
            </div>
            <div class="form-group">
              <label for="ctEmail">Email Address</label>
              <input type="email" id="ctEmail" name="email" placeholder="you@example.com">
              <span class="form-error">Please enter a valid email address.</span>
            </div>
            <div class="form-group">
              <label for="ctSubject">Subject *</label>
              <select id="ctSubject" name="subject" required>
                <option value="">Select a subject…</option>
                <option value="Product Enquiry">Product Enquiry</option>
                <option value="Prescription Glasses">Prescription Glasses</option>
                <option value="Contact Lenses">Contact Lenses</option>
                <option value="Sunglasses">Sunglasses</option>
                <option value="Frame Repair / Adjustment">Frame Repair / Adjustment</option>
                <option value="Other">Other</option>
              </select>
              <span class="form-error">Please select a subject.</span>
            </div>
            <div class="form-group">
              <label for="ctMessage">Message *</label>
              <textarea id="ctMessage" name="message" required placeholder="Tell us what you're looking for or how we can help…"></textarea>
              <span class="form-error">Please enter your message.</span>
            </div>
            <button type="submit" class="btn btn--whatsapp" style="width:100%;">
              <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Send via WhatsApp
            </button>
            <div class="form-success" id="contactSuccess">
              ✅ Opening WhatsApp with your message — please send it to complete your enquiry.
            </div>
          </form>
        </div>
      </div>

      <!-- HOURS & INFO -->
      <div>
        <h2 style="margin-bottom:1.5rem;">Store Information</h2>
        <div class="contact-form" style="margin-bottom:1.5rem;">
          <h3 style="font-size:1rem; margin-bottom:1.25rem;">Business Hours</h3>
          <table class="hours-table">
            <tbody>
              <tr><td>Monday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
              <tr><td>Tuesday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
              <tr><td>Wednesday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
              <tr><td>Thursday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
              <tr><td>Friday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
              <tr><td>Saturday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
              <tr><td>Sunday</td><td class="hours-open">10:00 AM – 7:00 PM</td></tr>
            </tbody>
          </table>
        </div>
        <div class="contact-form">
          <h3 style="font-size:1rem; margin-bottom:1.25rem;">Connect With Us</h3>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            <a href="tel:{{ site.phoneRaw }}" class="btn btn--primary" style="justify-content:center;">
              📞 Call {{ site.phone }}
            </a>
            <a href="https://wa.me/{{ site.whatsapp }}" class="btn btn--whatsapp" target="_blank" rel="noopener noreferrer" style="justify-content:center;">
              💬 Chat on WhatsApp
            </a>
            <a href="https://maps.google.com/?q=Centre+Point+Residency+Road+Bangalore+560025"
               class="btn btn--outline"
               target="_blank"
               rel="noopener noreferrer"
               style="justify-content:center;">
              📍 Get Directions
            </a>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
