---
layout: base.njk
title: Premium Eyewear & Optical Shop Bangalore
description: PIIXELL by Naina Optics — Bangalore's trusted optical shop since 2014. Shop Ray-Ban, Oakley, Crizal, Polaroid sunglasses, eyeglasses and contact lenses on Residency Road.
bodyClass: page-home
---

<!-- HERO -->
<section class="hero">
  <div class="container">
    <div class="hero__content">
      <div class="hero__eyebrow">
        <svg viewBox="0 0 24 24" fill="currentColor" width="14" height="14"><path d="M12 4.5C7 4.5 2.73 7.61 1 12c1.73 4.39 6 7.5 11 7.5s9.27-3.11 11-7.5c-1.73-4.39-6-7.5-11-7.5zM12 17c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5zm0-8c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3z"/></svg>
        Serving Bangalore Since {{ site.founded }}
      </div>
      <h1>See the World <span>Clearly</span></h1>
      <p class="hero__sub">
        Premium eyewear from Ray-Ban, Oakley, Crizal and more — expertly fitted by our team on Residency Road, Bangalore.
      </p>
      <div class="hero__actions">
        <a href="https://wa.me/{{ site.whatsapp }}?text=Hello%20PIIXELL%20by%20Naina%20Optics!%20I%27d%20like%20to%20enquire%20about%20your%20eyewear%20collection."
           class="btn btn--whatsapp"
           target="_blank"
           rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
        <a href="tel:{{ site.phoneRaw }}" class="btn btn--outline-white">
          <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          {{ site.phone }}
        </a>
      </div>
      <div class="hero__stats">
        <div>
          <span class="hero__stat-value">10+</span>
          <span class="hero__stat-label">Years in Bangalore</span>
        </div>
        <div>
          <span class="hero__stat-value">5000+</span>
          <span class="hero__stat-label">Happy Customers</span>
        </div>
        <div>
          <span class="hero__stat-value">20+</span>
          <span class="hero__stat-label">Premium Brands</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BRANDS -->
<section class="brands section--sm">
  <div class="container">
    <div class="section-header">
      <h2>Brands We Carry</h2>
      <p>Authorised retailer for Bangalore's most sought-after eyewear brands</p>
    </div>
    <div class="brands-grid">
      {% for brand in site.brands %}
      <span class="brand-chip">{{ brand }}</span>
      {% endfor %}
    </div>
  </div>
</section>

<!-- FEATURED PRODUCTS -->
<section class="section" style="background: var(--surface);">
  <div class="container">
    <div class="section-header">
      <h2>Featured Eyewear</h2>
      <p>Hand-picked favourites from our collection — available in-store now</p>
    </div>
    <div class="products-grid">
      {% for product in products | where("featured", true) %}
      <div class="product-card" data-category="{{ product.category }}">
        <div class="product-card__image product-card__image--placeholder">
          <!-- TODO: Add image: <img src="/assets/images/products/{{ product.image }}" alt="{{ product.alt }}" loading="lazy"> -->
          <span class="product-card__badge badge badge--product">{{ product.badge }}</span>
          {% if product.category == "sunglasses" %}🕶️
          {% elif product.category == "eyeglasses" %}👓
          {% else %}👁️{% endif %}
        </div>
        <div class="product-card__body">
          <div class="product-card__category">
            <span class="badge badge--{{ product.category }}">{{ product.categoryLabel | default(product.category) }}</span>
          </div>
          <h3 class="product-card__name">{{ product.name }}</h3>
          <p class="product-card__desc">{{ product.description }}</p>
          <div class="product-card__footer">
            <span class="product-card__price">{{ product.price }}</span>
            <button class="btn btn--accent btn--sm enquire-btn"
                    data-product="{{ product.name }}"
                    data-price="{{ product.price }}">
              Enquire
            </button>
          </div>
        </div>
      </div>
      {% endfor %}
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a href="/products/" class="btn btn--outline">View All Products →</a>
    </div>
  </div>
</section>

<!-- WHY CHOOSE US -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <h2>Why Choose Naina Optics?</h2>
      <p>Ten years of trusted service, premium brands, and expert advice in the heart of Bangalore</p>
    </div>
    <div class="features-grid fade-in">
      <div class="feature-card">
        <span class="feature-icon">🏆</span>
        <h3>10+ Years of Expertise</h3>
        <p>Since 2014, we've been Bangalore's trusted name in premium eyewear — with thousands of satisfied customers across the city.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">👓</span>
        <h3>Premium Brands</h3>
        <p>Authorised retailer for Ray-Ban, Oakley, Crizal, Polaroid and more — all genuine products with manufacturer warranty.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">🎯</span>
        <h3>Expert Advice</h3>
        <p>Our trained optical professionals help you find the perfect fit for your face shape, prescription, and lifestyle.</p>
      </div>
      <div class="feature-card">
        <span class="feature-icon">💰</span>
        <h3>Honest Pricing</h3>
        <p>Transparent prices with no hidden costs. Premium quality doesn't have to mean paying more than you should.</p>
      </div>
    </div>
  </div>
</section>

<!-- LATEST BLOG POSTS -->
<section class="section" style="background: var(--surface);">
  <div class="container">
    <div class="section-header">
      <h2>Eye Care Insights</h2>
      <p>Tips, guides, and news from our optical experts</p>
    </div>
    <div class="blog-grid">
      {% for article in articles | limit(3) %}
      <article class="article-card" data-category="{{ article.category }}">
        <div class="article-card__image">
          <!-- TODO: <img src="/assets/images/blog/{{ article.image }}" alt="{{ article.title }}" loading="lazy"> -->
          {% if article.category == "sunglasses" %}🕶️
          {% elif article.category == "eyeglasses" %}👓
          {% elif article.category == "contact-lenses" %}👁️
          {% elif article.category == "eye-care" %}🔬
          {% else %}📰{% endif %}
        </div>
        <div class="article-card__body">
          <div class="article-card__meta">
            <span class="badge badge--{{ article.category }}">{{ article.categoryLabel }}</span>
            <span>{{ article.readTime }} min read</span>
          </div>
          <h3 class="article-card__title">{{ article.title }}</h3>
          <p class="article-card__excerpt">{{ article.excerpt }}</p>
          <div class="article-card__footer">
            <span>{{ article.date | readableDate }}</span>
            <a href="/blog/" class="article-card__readmore">Read More →</a>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
    <div style="text-align:center; margin-top:2.5rem;">
      <a href="/blog/" class="btn btn--outline">View All Articles →</a>
    </div>
  </div>
</section>

<!-- CTA BANNER -->
<section class="cta-banner">
  <div class="container">
    <h2>Ready to Find Your Perfect Eyewear?</h2>
    <p>Visit us on Residency Road or chat with our experts on WhatsApp — we're here to help.</p>
    <div class="cta-banner__actions">
      <a href="https://wa.me/{{ site.whatsapp }}?text=Hello!%20I%27d%20like%20to%20get%20expert%20eyewear%20advice."
         class="btn btn--outline-white"
         target="_blank"
         rel="noopener noreferrer">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        WhatsApp Us
      </a>
      <a href="/contact/" class="btn btn--outline-white">Visit Our Store</a>
    </div>
  </div>
</section>

<!-- Enquiry modal (shared) -->
<div class="modal-overlay enquiry-modal" id="enquiryModal" role="dialog" aria-modal="true" aria-labelledby="enquiryTitle">
  <div class="modal">
    <button class="modal__close" id="closeEnquiry" aria-label="Close enquiry form">✕</button>
    <h2 id="enquiryTitle">Enquire About This Product</h2>
    <p style="color:var(--text-muted); margin-bottom:1.5rem; font-size:0.9rem;">Fill in your details and we'll send a WhatsApp message on your behalf to our team.</p>
    <form id="enquiryForm" novalidate>
      <div class="form-group">
        <label for="enqProduct">Product</label>
        <input type="text" id="enqProduct" name="product" readonly style="background:var(--border);">
      </div>
      <div class="form-row">
        <div class="form-group">
          <label for="enqName">Your Name *</label>
          <input type="text" id="enqName" name="name" required placeholder="Rahul Sharma">
          <span class="form-error">Please enter your name.</span>
        </div>
        <div class="form-group">
          <label for="enqPhone">Phone *</label>
          <input type="tel" id="enqPhone" name="phone" required placeholder="9876543210">
          <span class="form-error">Please enter your phone number.</span>
        </div>
      </div>
      <div class="form-group">
        <label for="enqMessage">Message (optional)</label>
        <textarea id="enqMessage" name="message" rows="3" placeholder="Any specific questions about this product?"></textarea>
      </div>
      <button type="submit" class="btn btn--whatsapp" style="width:100%;">
        <svg viewBox="0 0 24 24" fill="currentColor" width="18" height="18"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Send via WhatsApp
      </button>
    </form>
  </div>
</div>
