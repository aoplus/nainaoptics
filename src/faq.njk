---
layout: base.njk
title: FAQs — Common Questions About Eyewear & Eye Care
description: Answers to common questions about sunglasses, eyeglasses, contact lenses, and eye health from PIIXELL by Naina Optics, Bangalore.
bodyClass: page-faq
---

<div class="page-header">
  <div class="container">
    <h1>Frequently Asked Questions</h1>
    <p>Everything you need to know about eyewear, lenses, and eye care</p>
  </div>
</div>

<section class="faq-section">
  <div class="container">

    <!-- SEARCH -->
    <div class="faq-search-wrap">
      <div class="search-box">
        <svg class="search-box__icon" viewBox="0 0 24 24" fill="currentColor" width="18" height="18">
          <path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
        </svg>
        <input type="search" id="faqSearch" placeholder="Search FAQs…" aria-label="Search frequently asked questions">
      </div>
    </div>

    <!-- CATEGORY FILTER -->
    <div class="faq-categories filter-bar">
      <button class="filter-btn active" data-faq-filter="all">All Topics</button>
      <button class="filter-btn" data-faq-filter="about">About Us</button>
      <button class="filter-btn" data-faq-filter="sunglasses">Sunglasses</button>
      <button class="filter-btn" data-faq-filter="eyeglasses">Eyeglasses</button>
      <button class="filter-btn" data-faq-filter="contact-lenses">Contact Lenses</button>
      <button class="filter-btn" data-faq-filter="eye-health">Eye Health</button>
    </div>

    <!-- NO RESULTS MESSAGE -->
    <p id="faqNoResults" style="display:none; text-align:center; color:var(--text-muted); padding:2rem 0;">
      No matching questions found. <a href="https://wa.me/{{ site.whatsapp }}" target="_blank" rel="noopener noreferrer">Ask us on WhatsApp →</a>
    </p>

    <!-- FAQ GROUPS -->
    {% set categories = ["about", "sunglasses", "eyeglasses", "contact-lenses", "eye-health"] %}
    {% set categoryLabels = {
      "about": "About Us",
      "sunglasses": "Sunglasses",
      "eyeglasses": "Eyeglasses",
      "contact-lenses": "Contact Lenses",
      "eye-health": "Eye Health"
    } %}

    {% for cat in categories %}
    {% set catFaqs = faqs | where("category", cat) %}
    {% if catFaqs.length %}
    <div class="faq-group" data-faq-group="{{ cat }}">
      <h2 class="faq-group__title">{{ categoryLabels[cat] }}</h2>
      {% for faq in catFaqs %}
      <div class="faq-item" data-category="{{ faq.category }}" data-question="{{ faq.question | lower }}" data-answer="{{ faq.answer | lower }}">
        <button class="faq-question" aria-expanded="false">
          <span>{{ faq.question }}</span>
          <svg class="faq-chevron" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
            <path d="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6 1.41-1.41z"/>
          </svg>
        </button>
        <div class="faq-answer" role="region">
          <div class="faq-answer__inner">{{ faq.answer }}</div>
        </div>
      </div>
      {% endfor %}
    </div>
    {% endif %}
    {% endfor %}

  </div>
</section>

<!-- CTA -->
<section class="cta-banner">
  <div class="container">
    <h2>Still Have Questions?</h2>
    <p>Our team is happy to help — chat with us on WhatsApp or visit our store on Residency Road.</p>
    <div class="cta-banner__actions">
      <a href="https://wa.me/{{ site.whatsapp }}?text=Hi!%20I%20have%20a%20question%20about%20eyewear."
         class="btn btn--outline-white"
         target="_blank"
         rel="noopener noreferrer">
        Chat on WhatsApp
      </a>
      <a href="/contact/" class="btn btn--outline-white">Contact Us</a>
    </div>
  </div>
</section>
