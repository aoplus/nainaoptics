<header class="navbar" id="navbar">
  <div class="container navbar__inner">

    <a href="/" class="navbar__logo" aria-label="PIIXELL by Naina Optics — Home">
      <span class="logo-icon">
        <svg viewBox="0 0 40 40" fill="none" width="36" height="36" aria-hidden="true">
          <circle cx="20" cy="20" r="19" stroke="currentColor" stroke-width="2"/>
          <path d="M8 20 Q14 12 20 20 Q26 28 32 20" stroke="currentColor" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <circle cx="14" cy="20" r="4" stroke="currentColor" stroke-width="2"/>
          <circle cx="26" cy="20" r="4" stroke="currentColor" stroke-width="2"/>
          <line x1="18" y1="20" x2="22" y2="20" stroke="currentColor" stroke-width="2"/>
        </svg>
      </span>
      <span class="logo-text">
        <span class="logo-brand">PIIXELL</span>
        <span class="logo-sub">by Naina Optics</span>
      </span>
    </a>

    <nav class="navbar__links" id="navLinks" aria-label="Main navigation">
      <a href="/" class="nav-link{% if page.url == '/' %} active{% endif %}">Home</a>
      <a href="/products/" class="nav-link{% if '/products' in page.url %} active{% endif %}">Products</a>
      <a href="/about/" class="nav-link{% if '/about' in page.url %} active{% endif %}">About</a>
      <a href="/blog/" class="nav-link{% if '/blog' in page.url %} active{% endif %}">Blog</a>
      <a href="/faq/" class="nav-link{% if '/faq' in page.url %} active{% endif %}">FAQ</a>
      <a href="/contact/" class="nav-link{% if '/contact' in page.url %} active{% endif %}">Contact</a>
    </nav>

    <div class="navbar__actions">
      <a href="tel:{{ site.phoneRaw }}" class="btn btn--call" aria-label="Call Naina Optics">
        <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
          <path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/>
        </svg>
        Call Now
      </a>

      <button class="dark-toggle" id="darkToggle" aria-label="Toggle dark mode" type="button">
        <svg class="icon-sun" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M12 7c-2.76 0-5 2.24-5 5s2.24 5 5 5 5-2.24 5-5-2.24-5-5-5zM2 13h2c.55 0 1-.45 1-1s-.45-1-1-1H2c-.55 0-1 .45-1 1s.45 1 1 1zm18 0h2c.55 0 1-.45 1-1s-.45-1-1-1h-2c-.55 0-1 .45-1 1s.45 1 1 1zM11 2v2c0 .55.45 1 1 1s1-.45 1-1V2c0-.55-.45-1-1-1s-1 .45-1 1zm0 18v2c0 .55.45 1 1 1s1-.45 1-1v-2c0-.55-.45-1-1-1s-1 .45-1 1zM5.99 4.58c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .38-.39.39-1.03 0-1.41L5.99 4.58zm12.37 12.37c-.39-.39-1.03-.39-1.41 0-.39.39-.39 1.03 0 1.41l1.06 1.06c.39.39 1.03.39 1.41 0 .39-.38.39-1.03 0-1.41l-1.06-1.06zm1.06-12.37l-1.06 1.06c-.39.39-.39 1.03 0 1.41.39.39 1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0zM7.05 18.36l-1.06 1.06c-.39.39-.39 1.03 0 1.41.39.39 1.03.39 1.41 0l1.06-1.06c.39-.39.39-1.03 0-1.41s-1.03-.39-1.41 0z"/>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" width="20" height="20">
          <path d="M12 3c-4.97 0-9 4.03-9 9s4.03 9 9 9 9-4.03 9-9c0-.46-.04-.92-.1-1.36-.98 1.37-2.58 2.26-4.4 2.26-2.98 0-5.4-2.42-5.4-5.4 0-1.81.89-3.42 2.26-4.4-.44-.06-.9-.1-1.36-.1z"/>
        </svg>
      </button>

      <button class="hamburger" id="hamburger" aria-label="Toggle menu" aria-expanded="false" aria-controls="navLinks" type="button">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>

  </div>
</header>
